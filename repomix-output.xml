const TOPIC_KEYWORD_TO_TOKEN = TOPIC_DEFINITIONS.reduce<Record<string, string>>((acc, definition) => {
  for (const keyword of definition.keywords) {
    acc[normalizeText(keyword)] = definition.token;
  }
  return acc;
}, {});

