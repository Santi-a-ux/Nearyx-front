                    >
                      <Trash2 className="h-4 w-4 text-muted-foreground" />
                    </Button>
                  </div>

                  <div className="space-y-2">
                    <Label htmlFor={`cert-name-${index}`}>Nombre del curso o certificación</Label>
                    <Input
                      id={`cert-name-${index}`}
