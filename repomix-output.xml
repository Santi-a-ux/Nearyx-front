    <nav className="text-sm text-muted-foreground">
      {segments.length === 0 ? (
        <span>Inicio</span>
      ) : (
        <span>
          {segments.map((seg, idx) => (
            <span key={idx} className="capitalize">{labels[seg] ?? seg.replace(/-/g, ' ')}{idx < segments.length - 1 ? ' / ' : ''}</span>
          ))}
        </span>
