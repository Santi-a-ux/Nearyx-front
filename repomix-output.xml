/* =========================
   ACCESSIBILITY — HIGH CONTRAST MODE
========================== */

.high-contrast {
  --background: #000000;
  --foreground: #ffffff;

  --card: #000000;
  --card-foreground: #ffffff;

  --popover: #000000;
