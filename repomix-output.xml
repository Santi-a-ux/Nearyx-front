  --color-text: #ffffff;
  --color-text-muted: #d4d4d4;
  --color-bg: #000000;
  --color-border: #ffd400;
  --color-accent: #ffd400;
}

.high-contrast,
.high-contrast body {
  background-color: #000000 !important;
  color: #ffffff !important;
}

/* =========================
   Regla general para el alto contraste
========================== */

.high-contrast *:not(:where(.mapbox-host, .mapbox-host *)) {
  background-color: transparent !important;
  background-image: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  color: #ffffff !important;
  border-color: #ffd400 !important;
  outline-color: #ffd400 !important;
  text-shadow: none !important;
  box-shadow: none !important;
}

.high-contrast a,
.high-contrast button {
  text-underline-offset: 3px;
}

/* =========================
   Arreglo para los paneles
========================== */

.high-contrast header,
.high-contrast [data-slot="sidebar"],
.high-contrast [data-slot="sidebar-inner"],
.high-contrast [data-slot="dialog-content"],
.high-contrast [data-slot="sheet-content"],
.high-contrast [data-slot="tooltip-content"],
.high-contrast [role="dialog"],
.high-contrast [role="menu"],
.high-contrast [role="listbox"],
.high-contrast [data-radix-popper-content-wrapper] {
  background-color: #000000 !important;
  background-image: none !important;
}

/* Notificaciones */
.high-contrast [data-sonner-toast],
.high-contrast .cn-toast {
  background-color: var(--popover) !important;
  color: var(--popover-foreground) !important;
  border-color: var(--border) !important;
}

/* =========================
   Tarjetas
========================== */

.high-contrast [class*="backdrop-blur"] {
  background-color: #000000 !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

/* Arregla el fondo difuminado */
.high-contrast [data-slot="dialog-overlay"],
.high-contrast [data-slot="sheet-overlay"] {
  background-color: rgba(0, 0, 0, 0.7) !important;
  backdrop-filter: blur(4px) !important;
  -webkit-backdrop-filter: blur(4px) !important;
}

/* =========================
    Reinstanciar clases para evitar problemas 
========================== */

.high-contrast .bg-background { background-color: var(--background) !important; }
.high-contrast .text-foreground,
.high-contrast .text-foreground * { color: var(--foreground) !important; }
.high-contrast .bg-foreground { background-color: var(--foreground) !important; }
.high-contrast .text-background,
.high-contrast .text-background * { color: var(--background) !important; }

.high-contrast .bg-card { background-color: var(--card) !important; }
.high-contrast .text-card-foreground,
.high-contrast .text-card-foreground * { color: var(--card-foreground) !important; }

.high-contrast .bg-popover { background-color: var(--popover) !important; }
.high-contrast .text-popover-foreground,
.high-contrast .text-popover-foreground * { color: var(--popover-foreground) !important; }

.high-contrast .bg-primary { background-color: var(--primary) !important; }
.high-contrast .text-primary,
.high-contrast .text-primary * { color: var(--primary) !important; }
.high-contrast .text-primary-foreground,
.high-contrast .text-primary-foreground * { color: var(--primary-foreground) !important; }
.high-contrast .border-primary { border-color: var(--primary) !important; }

.high-contrast .bg-accent { background-color: var(--accent) !important; }
.high-contrast .text-accent-foreground,
.high-contrast .text-accent-foreground * { color: var(--accent-foreground) !important; }

.high-contrast .text-secondary-foreground,
.high-contrast .text-secondary-foreground * { color: var(--secondary-foreground) !important; }

.high-contrast .bg-destructive { background-color: var(--destructive) !important; }
.high-contrast .text-destructive,
.high-contrast .text-destructive * { color: var(--destructive) !important; }

/* =========================
   Bordes on hover
========================== */

.high-contrast .sidebar-menu-item {
  color: #ffffff !important;
  border-bottom: 1px solid rgba(255, 212, 0, 0.35) !important;
}

.high-contrast .sidebar-menu-item:hover,
.high-contrast .sidebar-menu-item.active,
.high-contrast .nav-item.active,
.high-contrast .chip.active,
.high-contrast .btn-primary {
  background-color: #ffd400 !important;
  color: #000000 !important;
}

/* Fondos de los avatar */
.high-contrast [data-slot="avatar-fallback"] {
  background-color: #000000 !important;
  color: #ffd400 !important;
}

.high-contrast img,
.high-contrast svg {
  filter: none !important;
}

/* =========================
   BASE
========================== */

@layer base {
  * {
    @apply border-border outline-ring/50;
    transition: colors 0.2s ease;
    font-family: var(--font-body) !important;
  }

  html {
    font-family: var(--font-body) !important;
  }

  body {
    @apply bg-background text-foreground;
    background-color: #ffffff;
    color: #282828;
    min-block-size: 100%;
    font-family: var(--font-body) !important;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-heading) !important;
    font-weight: 500;
    color: #282828;
    letter-spacing: -0.01em;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.12;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.2;
  }

  h3 {
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    line-height: 1.28;
  }
}

/* =========================
   ANIMATIONS
========================== */

@keyframes radar-pulse {
  0% {
    transform: scale(0.7);
    opacity: 0.75;
  }

  70% {
    opacity: 0.15;
  }

  100% {
    transform: scale(2.4);
    opacity: 0;
  }
}

@keyframes radar-pulse-2 {
  0% {
    transform: scale(0.7);
    opacity: 0.6;
  }

  60% {
    opacity: 0.12;
  }

  100% {
    transform: scale(2.8);
    opacity: 0;
  }
}

@keyframes ping-dot {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(0, 88, 255, 0.45);
  }

  50% {
    transform: scale(1.08);
    box-shadow: 0 0 0 10px rgba(0, 88, 255, 0);
  }
}

.radar-ring {
  animation: radar-pulse 2.8s ease-out infinite;
}

.radar-ring-2 {
  animation: radar-pulse-2 3.4s ease-out infinite;
  animation-delay: 0.35s;
}

.radar-ring-3 {
  animation: radar-pulse 4s ease-out infinite;
  animation-delay: 0.7s;
}

.user-dot {
  animation: ping-dot 2.2s ease-in-out infinite;
}

.scrollbar-none {
  scrollbar-width: none;
}

.scrollbar-none::-webkit-scrollbar {
  display: none;
}

/* =========================
   COMPONENTS
========================== */

@layer components {

  /* =========================
     BUTTONS
  ========================== */

  .btn-primary {
    @apply rounded-lg px-4 py-2 text-sm font-medium transition-all;
    background-color: #0058ff;
    color: #ffffff;
    border: 1px solid #0058ff;
    font-family: var(--font-body);
    font-weight: 700;
  }

  .btn-primary:hover {
    background-color: #172554;
    border-color: #172554;
    opacity: 1;
  }

  .btn-ghost {
    @apply rounded-lg px-4 py-2 text-sm transition-all;
    border: 1px solid rgba(217, 227, 244, 0.88);
    color: #374151;
    background-color: transparent;
    font-family: var(--font-body);
    font-weight: 700;
  }

  .btn-ghost:hover {
    background-color: rgba(0, 88, 255, 0.08);
    color: #172554;
    border-color: rgba(0, 88, 255, 0.28);
  }

  .btn-secondary {
    @apply rounded-lg px-4 py-3 text-sm transition-all;
    background-color: #ffffff;
    color: #0058ff;
    border: 1px solid rgba(0, 88, 255, 0.26);
    font-family: var(--font-body);
    font-weight: 700;
  }

  .btn-secondary:hover {
    background-color: #f4f8ff;
  }

  /* =========================
     CARDS
  ========================== */

  .card {
    @apply rounded-lg transition-colors;
    background-color: #ffffff;
    border: 1px solid #d9e3f4;
    padding: 1rem 1.25rem;
    color: #282828;
    box-shadow: 0 12px 34px rgba(15, 23, 42, 0.08);
  }

  .card:hover {
    border-color: rgba(217, 227, 244, 0.88);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #d9e3f4;
    padding-bottom: 12px;
    margin-bottom: 16px;
  }

  /* =========================
     CHIP
  ========================== */

  .chip {
    @apply rounded-full px-3 py-1 text-xs font-medium cursor-pointer transition-all;
    background-color: rgba(0, 88, 255, 0.08);
    border: 1px solid rgba(0, 88, 255, 0.2);
    color: #172554;
    font-family: var(--font-body);
  }

  .chip.active {
    background-color: #0058ff;
    color: #ffffff;
    border-color: #0058ff;
  }

  /* =========================
     INPUT
  ========================== */

  .field-input {
    @apply w-full rounded-lg py-3 pl-4 pr-4 text-sm outline-none transition-colors;
    background-color: #ffffff;
    border: 1px solid #d9e3f4;
    color: #282828;
    font-family: var(--font-body);
  }

  .field-input::placeholder {
    color: #4b5563;
  }

  .field-input:focus {
    border-color: #60a5fa;
    box-shadow: 0 0 0 3px rgba(0, 88, 255, 0.14);
  }

  /* =========================
     NAV ITEM
  ========================== */

  .nav-item {
    @apply flex items-center gap-2.5 px-4 py-2.5 text-sm rounded-lg mx-2 cursor-pointer transition-all;
    color: #374151;
    font-family: var(--font-body);
    font-weight: 700;
  }

  .nav-item:hover {
    background-color: rgba(0, 88, 255, 0.08);
    color: #172554;
  }

  .nav-item.active {
    background-color: rgba(0, 88, 255, 0.14);
    color: #172554;
    border-left: 3px solid #0058ff;
  }

  /* =========================
     ONLINE INDICATOR
  ========================== */

  .online-indicator {
    @apply w-1.5 h-1.5 rounded-full;
    background-color: #16a34a;
    box-shadow: 0 0 8px rgba(22, 163, 74, 0.4);
  }

  /* =========================
     STATUS BADGE
  ========================== */

  .status-badge {
    @apply rounded-full px-3 py-1 text-xs font-medium inline-flex items-center gap-2;
    background-color: rgba(0, 88, 255, 0.1);
    border: 1px solid rgba(0, 88, 255, 0.25);
    color: #172554;
    font-family: var(--font-body);
    font-weight: 700;
  }

  .hero-glow {
    @apply pointer-events-none absolute inset-0;
    background: radial-gradient(ellipse at top center, rgba(142, 197, 252, 0.45), transparent 72%);
  }

  .accent-glow {
    filter: drop-shadow(0 0 8px rgba(0, 88, 255, 0.2));
  }
}

/* =========================
   SIDEBAR
========================== */

[data-slot="sidebar"],
[data-slot="sidebar-inner"] {
  background-color: #0f172a !important;
  color: #f8fbff !important;
}

[data-slot="sidebar-inner"] {
  border-right: 1px solid rgba(148, 163, 184, 0.28) !important;
}

[data-slot="sidebar-container"] {
  transition: width 0.25s ease;
}

[data-state="collapsed"] [data-slot="sidebar-container"] {
  width: var(--sidebar-width-icon);
}

[data-state="expanded"] [data-slot="sidebar-container"] {
  width: var(--sidebar-width);
}

.sidebar-menu {
  padding: 12px 0;
}

.sidebar-menu-item {
  padding: 10px 16px;
  color: rgba(248, 251, 255, 0.75);
  font-size: 15px;
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: var(--font-body);
  border-bottom: 1px solid rgba(248, 251, 255, 0.05);
}

.sidebar-menu-item:hover {
  background-color: rgba(248, 251, 255, 0.07);
  color: #f8fbff;
}

.sidebar-menu-item.active {
  background-color: rgba(0, 88, 255, 0.25);
  border-left: 3px solid #0058ff;
  color: #f8fbff;
}

/* =========================
   TOPBAR
========================== */

header,
nav[data-topbar],
.topbar,
[data-slot="header"] {
  background-color: #F8FBFF !important;
  border-bottom: 1px solid #d9e3f4 !important;
  color: #282828 !important;
}

/* =========================
   DIVIDERS
========================== */

hr,
[data-slot="separator"],
.divider {
  border: none;
  border-top: 1px solid rgba(217, 227, 244, 0.72);
}

/* =========================
   TRANSITIONS
========================== */

a,
button,
input,
textarea {
  transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
}

/* =========================
   NEARYX DESIGN SYSTEM — tipografía y utilidades
========================== */

@layer base {
  html {
    font-optical-sizing: auto;
  }

  body {
    font-family: var(--font-body);
  }
}

@layer utilities {
  .font-display {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "SOFT" 50;
  }

  .text-display-xl {
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 4.25rem;
    letter-spacing: -0.02em;
    font-weight: 600;
    font-variation-settings: "SOFT" 50;
  }

  .text-display-lg {
    font-family: var(--font-display);
    font-size: 2.75rem;
    line-height: 3rem;
    letter-spacing: -0.015em;
    font-weight: 600;
    font-variation-settings: "SOFT" 50;
  }

  .text-display-md {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 2.375rem;
    letter-spacing: -0.01em;
    font-weight: 600;
  }

  .text-h2 {
    font-size: 1.5rem;
    line-height: 1.875rem;
    font-weight: 600;
  }

  .text-h3 {
    font-size: 1.125rem;
    line-height: 1.5rem;
    font-weight: 600;
  }

  .text-body-lg {
    font-size: 1.0625rem;
    line-height: 1.625rem;
    font-weight: 400;
  }

  .text-body {
    font-size: 0.9375rem;
    line-height: 1.375rem;
    font-weight: 400;
  }

  .text-label {
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .text-caption {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.125rem;
    font-weight: 500;
  }

  .card-elevated {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--card);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow 150ms ease-out,
      transform 150ms ease-out;
  }

  .card-elevated:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .hero-gradient {
    background: linear-gradient(180deg, var(--background) 0%, color-mix(in srgb, var(--brand-soft) 35%, var(--background)) 100%);
  }
}

/* =========================
   MAPBOX
========================== */

.mapbox-host .mapboxgl-map,
.mapbox-host .mapboxgl-canvas-container,
.mapbox-host canvas.mapboxgl-canvas {
  width: 100% !important;
  height: 100% !important;
}
