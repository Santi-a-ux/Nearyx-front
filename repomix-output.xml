                  <div className="space-y-2">
                    <Label htmlFor={`exp-org-${index}`}>Organización</Label>
                    <Input
                      id={`exp-org-${index}`}
                      value={item.organization}
                      onChange={(e) => updateAt(setExperience, index, { organization: e.target.value })}
